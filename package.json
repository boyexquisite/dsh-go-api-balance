{
  "name": "dsh-go-api-balance",
  "version": "0.4.1",
  "description": "API balance, usage and subscription quotas for the dsh-go app: a native panel that reads balances from any HTTP endpoint with an API key or site token. Eight templates included; credentials stay on the host.",
  "license": "MIT",
  "author": "miao",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-go",
    "deepseek-harness",
    "harness",
    "plugin",
    "balance",
    "api-key",
    "dshGo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/boyexquisite/dsh-go-api-balance.git"
  },
  "homepage": "https://github.com/boyexquisite/dsh-go-api-balance#readme",
  "bugs": {
    "url": "https://github.com/boyexquisite/dsh-go-api-balance/issues"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "API 余额",
      "en": "API balance"
    },
    "icon": "wallet",
    "contributes": {
      "composer.strip": [
        {
          "id": "balance-strip",
          "icon": "wallet",
          "panel": "balance"
        }
      ],
      "panels": [
        {
          "id": "balance",
          "title": {
            "zh": "API 余额",
            "en": "API balance"
          },
          "icon": "wallet",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
